<Window x:Class="Test_04._03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Test_04._03"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#7FFF00">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/Icon.png" HorizontalAlignment="Left" Height="40" Margin="5"/>
                    <TextBlock Text="Главная страница" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5" FontSize="16" FontWeight="Bold"
                               FontFamily="Times New Roman"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <TextBlock x:Name="FIO" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5" FontSize="14"/>
                    <Border Padding="3" BorderThickness="1" BorderBrush="#00FA9A" CornerRadius="3" Background="#00FA9A" VerticalAlignment="Center">
                        <Button Content="Сменить пользователя" Background="#00FA9A" BorderThickness="0" Click="Logout_Click" Height="30" Width="130" FontFamily="Times New Roman"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock x:Name="Information" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" FontSize="16" FontFamily="Times New Roman"/>
    </Grid>
</Window>
