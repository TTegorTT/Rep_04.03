<Page x:Class="Test_04._03.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Test_04._03"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="500"
      Title="AuthorizationPage"
      Background="white">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Авторизация" HorizontalAlignment="Center" FontSize="16" FontFamily="Times New Roman"/>
            <StackPanel Margin="0, 5, 0, 0">
                <TextBlock Text="Логин" FontFamily="Times New Roman"/>
                <Border Background="#7FFF00" Padding="3" BorderThickness="1" BorderBrush="#00FA9A" CornerRadius="3" >
                    <TextBox x:Name="Login" BorderThickness="0" Background="#7FFF00" FontFamily="Times New Roman"/>
                </Border>
            </StackPanel>
            <StackPanel Margin="0, 5, 0, 0">
                <TextBlock Text="Пароль" FontFamily="Times New Roman"/>
                <Border Padding="3" Background="#7FFF00" BorderThickness="1" BorderBrush="#00FA9A" CornerRadius="3">
                    <TextBox x:Name="Password" BorderThickness="0" Background="#7FFF00" FontFamily="Times New Roman"/>
                </Border>
            </StackPanel>
            <Border Padding="3" BorderThickness="1" BorderBrush="#00FA9A" CornerRadius="3" Margin="0, 20, 0, 0"
                    Background="#7FFF00">
                <Button Content="Войти" Background="#7FFF00" BorderThickness="0" Click="Login_Click" FontFamily="Times New Roman"/>
            </Border>
            <Border Padding="3" BorderThickness="1" BorderBrush="#00FA9A" CornerRadius="3" Margin="0, 20, 0, 0"
                    Background="#7FFF00">
                <Button Content="Войти как гость" Background="#7FFF00" BorderThickness="0" Click="GuestLogin_Click" FontFamily="Times New Roman"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
